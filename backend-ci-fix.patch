+// GENERATED by scripts/sync-shared.mjs from the `shared` submodule. Do not edit; run `pnpm sync:shared`.
+/** Canonical enums and constants (spec v1.4 §3, §4, §7, §17). Values match the database enums. */
+
+export const ROLES = ["STUDENT", "MODERATOR", "ADMIN"] as const;
+export type Role = (typeof ROLES)[number];
+
+export const USER_STATUSES = ["ACTIVE", "SUSPENDED"] as const;
+export type UserStatus = (typeof USER_STATUSES)[number];
+
+export const COURSE_STATUSES = ["DRAFT", "PUBLISHED"] as const;
+export type CourseStatus = (typeof COURSE_STATUSES)[number];
+
+export const RUNTIME_STACKS = ["NODE_BACKEND", "PYTHON_BACKEND", "FRONTEND_PLAIN", "FRONTEND_REACT"] as const;
+export type RuntimeStack = (typeof RUNTIME_STACKS)[number];
+
+export const COHORT_STATUSES = ["DRAFT", "ACTIVE", "COMPLETED"] as const;
+export type CohortStatus = (typeof COHORT_STATUSES)[number];
+
+export const MEMBER_ROLES = ["STUDENT", "MODERATOR"] as const;
+export type MemberRole = (typeof MEMBER_ROLES)[number];
+
+export const ENROLLMENT_STATUSES = ["ACTIVE", "DROPPED"] as const;
+export type EnrollmentStatus = (typeof ENROLLMENT_STATUSES)[number];
+
+export const JUDGING_MODES = ["ARBITER", "PEER", "MODERATOR"] as const;
+export type JudgingMode = (typeof JUDGING_MODES)[number];
+
+export const ERROR_CODES = [
+  "TASK_ALREADY_GRADING",
+  "TOO_MANY_ACTIVE_SUBMISSIONS",
+  "COOLDOWN_ACTIVE",
+  "PROJECT_LOCKED",
+  "ACCOUNT_SUSPENDED",
+  "REPO_NOT_FOUND",
+  "REPO_NOT_PUBLIC",
+  "FILE_MISSING",
+  "FILE_TOO_LARGE",
+  "REVIEW_LINK_CLOSED",
+  "SELF_REVIEW_NOT_ALLOWED",
+  "ALREADY_REVIEWED",
+  "COMPETITION_CLOSED",
+  "FORBIDDEN_COHORT",
+  // Foundations (Phase 0)
+  "UNAUTHENTICATED",
+  "FORBIDDEN",
+  "VALIDATION_FAILED",
+  "NOT_FOUND",
+  "CONFLICT",
+  "GITHUB_USER_NOT_FOUND",
+  "GITHUB_UNAVAILABLE",
+  "INTERNAL",
+] as const;
+export type ErrorCode = (typeof ERROR_CODES)[number];
+
+/** The single error shape used by every API (spec §17). */
+export type ApiError = { error: { code: ErrorCode; message: string; details?: Record<string, unknown> } };
+
+export const apiError = (code: ErrorCode, message: string, details: Record<string, unknown> = {}): ApiError => ({
+  error: { code, message, details },
+});
+
+/** Wall-clock defaults are stored in UTC (spec §1, §4). */
+export const DEFAULTS = {
+  unlockTimeUtc: "05:00", // 06:00 in Lagos (WAT, UTC+1)
+  phase1Hours: 24,
+  phase2Hours: 48,
+  leaderboardRevealUtc: "17:00", // 18:00 in Lagos
+  maxConcurrentSubmissions: 3,
+  submissionCooldownSeconds: 30,
+  defaultTimeZone: "Africa/Lagos",
+} as const;
