+// GENERATED by scripts/sync-shared.mjs from the `shared` submodule. Do not edit; run `pnpm sync:shared`.
+/** Date and time-zone helpers. All instants are UTC; display uses the viewer's IANA zone (spec §1, §3). */
+
+export function isValidTimeZone(tz: string): boolean {
+  if (!tz || typeof tz !== "string") return false;
+  try {
+    new Intl.DateTimeFormat("en-US", { timeZone: tz });
+    return true;
+  } catch {
+    return false;
+  }
+}
+
+/** Browser-detected IANA zone, or null when unavailable. */
+export function detectTimeZone(): string | null {
+  try {
+    const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
+    return tz && isValidTimeZone(tz) ? tz : null;
+  } catch {
+    return null;
+  }
+}
+
+export type FormatOptions = { withDate?: boolean; locale?: string };
+
+/** Format a UTC instant in the given IANA time zone, e.g. "06:00" or "Mon, 24 Nov 2026, 06:00". */
+export function formatInTimeZone(instant: Date | string, timeZone: string, opts: FormatOptions = {}): string {
+  const date = typeof instant === "string" ? new Date(instant) : instant;
+  if (Number.isNaN(date.getTime())) return "";
+  const tz = isValidTimeZone(timeZone) ? timeZone : "UTC";
+  return new Intl.DateTimeFormat(opts.locale ?? "en-GB", {
+    timeZone: tz,
+    hour: "2-digit",
+    minute: "2-digit",
+    hour12: false,
+    ...(opts.withDate ? { weekday: "short", day: "2-digit", month: "short", year: "numeric" } : {}),
+  }).format(date);
+}
+
+/** Build a UTC instant from a calendar date (YYYY-MM-DD) and an "HH:MM" UTC time. */
+export function utcInstant(dateIso: string, timeUtc: string): Date {
+  return new Date(`${dateIso}T${timeUtc}:00.000Z`);
+}
