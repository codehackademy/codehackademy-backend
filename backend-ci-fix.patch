+// GENERATED by scripts/sync-shared.mjs from the `shared` submodule. Do not edit; run `pnpm sync:shared`.
+import { z } from "zod";
+import { COHORT_STATUSES, RUNTIME_STACKS } from "../constants.ts";
+
+const uuid = z.uuid("Invalid identifier.");
+const isoDate = z.string().regex(/^\d{4}-\d{2}-\d{2}$/, "Use the format YYYY-MM-DD.");
+
+export const slugSchema = z
+  .string()
+  .trim()
+  .min(2)
+  .max(60)
+  .regex(/^[a-z0-9]+(?:-[a-z0-9]+)*$/, "Use lowercase letters, numbers and hyphens.");
+
+export const courseSchema = z.object({
+  name: z.string().trim().min(2, "Enter a course name.").max(120),
+  slug: slugSchema,
+  description: z.string().trim().max(2000).default(""),
+  runtimeStack: z.enum(RUNTIME_STACKS, "Choose a runtime stack."),
+});
+export type CourseInput = z.infer<typeof courseSchema>;
+
+export const cohortSchema = z
+  .object({
+    name: z.string().trim().min(2, "Enter a cohort name.").max(120),
+    startDate: isoDate,
+    endDate: isoDate.optional().or(z.literal("").transform(() => undefined)),
+  })
+  .refine((v) => !v.endDate || v.endDate >= v.startDate, { path: ["endDate"], message: "End date must be after the start date." });
+export type CohortInput = z.infer<typeof cohortSchema>;
+
+export const addCourseToCohortSchema = z.object({
+  cohortId: uuid,
+  courseId: uuid,
+  courseStartDate: isoDate,
+});
+export type AddCourseToCohortInput = z.infer<typeof addCourseToCohortSchema>;
+
+/** Admin-created accounts. Admins are never created through the app. */
+export const inviteUserSchema = z
+  .object({
+    role: z.enum(["STUDENT", "MODERATOR"], "Choose a role."),
+    name: z.string().trim().min(2, "Enter a name.").max(120),
+    email: z.email("Enter a valid email address.").max(254),
+    cohortId: uuid.optional(),
+    courseId: uuid.optional(),
+  })
+  .refine((v) => v.role !== "STUDENT" || (v.cohortId && v.courseId), {
+    path: ["cohortId"],
+    message: "Choose a cohort and a course for the student.",
+  });
+export type InviteUserInput = z.infer<typeof inviteUserSchema>;
+
+export const cohortStatusSchema = z.enum(COHORT_STATUSES);
